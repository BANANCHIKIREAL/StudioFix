<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="StudioFix" Width="384" Height="466" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Foreground="#F3F3F3" FontSize="12">
 <Window.Resources>
  <Style TargetType="Button" x:Key="Button">
   <Setter Property="Background" Value="#161616"/><Setter Property="Foreground" Value="#DEDEDE"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="Medium"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.28"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <Border CornerRadius="17" BorderBrush="#292929" BorderThickness="1" Margin="7" Padding="24,18,24,16" Background="#080808">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="TitleBar"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="BrandIcon" Width="12" Height="12" Margin="0,0,7,0" Opacity="0.55"/><TextBlock Text="studiofix" Foreground="#777777" FontSize="11"/></StackPanel>
    <Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource Button}" Padding="5" Background="Transparent" Height="24" AutomationProperties.Name="Закрыть"><Image x:Name="CloseIcon" Width="12" Height="12" Opacity="0.55"/></Button>
   </Grid>
   <StackPanel Grid.Row="1" Margin="0,23,0,0">
    <Grid Width="52" Height="52" HorizontalAlignment="Center" Margin="0,0,0,15">
     <Ellipse x:Name="LoadingRing" Stroke="#9A9A9A" StrokeThickness="1.3" StrokeDashArray="2,6" Opacity="0.7" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform></Ellipse>
     <Image x:Name="HeroIcon" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <Border x:Name="StatusPill" Background="Transparent" HorizontalAlignment="Center" Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Fill="#777777" Width="3" Height="3" Margin="0,0,6,0"/><TextBlock x:Name="StatusText" Text="ПРОВЕРКА" Foreground="#777777" FontSize="9" FontWeight="Medium"/></StackPanel></Border>
    <TextBlock x:Name="HeadingText" Text="Ищем версию и фикс" FontSize="21" FontWeight="Medium" TextAlignment="Center" Margin="0,0,0,8"/>
    <TextBlock x:Name="DescriptionText" Text="Проверяем Studio и доступные правки." Foreground="#7D7D7D" FontSize="11" TextAlignment="Center" LineHeight="16" MinHeight="32" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
    <Grid Margin="0,19,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="TikTok LIVE Studio" Foreground="#8A8A8A" FontSize="11"/><TextBlock x:Name="VersionText" Grid.Column="1" Text="…" Foreground="#C9C9C9" FontSize="11" FontFamily="Consolas"/>
    </Grid>
    <TextBlock x:Name="FixText" Text="Проверяем сетевой код" Foreground="#505050" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,0,17"/>
    <Button x:Name="PrimaryButton" Content="Проверяем…" Background="#F3F3F3" Foreground="#0B0B0B" Style="{StaticResource Button}" FontSize="12" Height="40" IsEnabled="False"/>
    <Button x:Name="SecondaryButton" Content="Запустить без фикса" Background="Transparent" Foreground="#676767" FontSize="10" Padding="6,8" Margin="0,4,0,0" Style="{StaticResource Button}" HorizontalAlignment="Center" IsEnabled="False"/>
    <TextBlock x:Name="NoticeText" Text="" Foreground="#A0A0A0" FontSize="10" TextAlignment="Center" Margin="0,7,0,0" MaxHeight="28" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
   <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#1C1C1C" Height="1" Margin="0,0,0,9"/>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="UpdateButton" Style="{StaticResource Button}" Background="Transparent" Foreground="#646464" Padding="0,3" HorizontalAlignment="Left" FontSize="10" AutomationProperties.Name="Обновления"><StackPanel Orientation="Horizontal"><Image x:Name="UpdateIcon" Width="11" Height="11" Opacity="0.55" Margin="0,0,6,0"/><TextBlock x:Name="UpdateLabel" Text="Обновления"/></StackPanel></Button>
     <TextBlock x:Name="CatalogText" Grid.Column="1" Text="v1" Foreground="#3B3B3B" FontSize="9" VerticalAlignment="Center" Margin="0,0,10,0"/>
     <Button x:Name="SettingsButton" Grid.Column="2" Style="{StaticResource Button}" Background="Transparent" Padding="3" AutomationProperties.Name="Настройки" ToolTip="Настройки"><Image x:Name="SettingsIcon" Width="13" Height="13" Opacity="0.55"/></Button>
    </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>
